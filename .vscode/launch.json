{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--install-extension=batisteo.vscode-django",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}