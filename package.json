{
  "name": "htmx-tags-django",
  "displayName": "HTMX Tags for Django",
  "description": "HTMX 2/4 IntelliSense, diagnostics, and Django 6 template partial support.",
  "version": "0.2.0",
  "publisher": "difegam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/difegam/htmx-tags"
  },
  "homepage": "https://github.com/difegam/htmx-tags",
  "bugs": {
    "url": "https://github.com/difegam/htmx-tags/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "htmx",
    "html",
    "django",
    "templates",
    "partials",
    "intellisense"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:django-html"
  ],
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0C4B33",
    "theme": "dark"
  },
  "contributes": {
    "configuration": {
      "title": "HTMX Tags for Django",
      "properties": {
        "htmxTags.enableCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable HTMX and Django partial completions."
        },
        "htmxTags.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Enable HTMX and Django partial hover documentation."
        },
        "htmxTags.enableValidation": {
          "type": "boolean",
          "default": true,
          "description": "Enable HTMX and same-file Django partial diagnostics."
        },
        "htmxTags.version": {
          "type": "string",
          "enum": [
            "compatible",
            "2",
            "4"
          ],
          "enumDescriptions": [
            "Accept the HTMX 2 and HTMX 4 union.",
            "Prefer HTMX 2 and hint when HTMX 4-only syntax is used.",
            "Prefer HTMX 4 and hint when HTMX 2-only syntax is used."
          ],
          "default": "compatible",
          "description": "Select the HTMX compatibility mode."
        }
      }
    },
    "snippets": [
      {
        "language": "django-html",
        "path": "./snippets/django-htmx.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint .",
    "check-types": "tsc -p ./ --noEmit",
    "build-data": "uv --cache-dir .cache/uv run python build-data.py",
    "test": "npm run test:unit && uv --cache-dir .cache/uv run pytest -q",
    "test:unit": "npm run compile && node --test out/test/*.test.js",
    "test:extension": "npm run compile && node out/test/runTest.js",
    "capture-screenshots": "npm run compile && node out/test/captureScreenshots.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^9.26.0",
    "typescript": "^5.8.3"
  },
  "extensionDependencies": [
    "batisteo.vscode-django"
  ]
}
